# Copy to .env on the server. Do not commit .env.
POSTGRES_DB=portatlas
POSTGRES_USER=portatlas
POSTGRES_PASSWORD=replace-with-a-long-random-password
# Prefer the fields above. DATABASE_URL is an optional override for manual backend/Alembic runs;
# Compose passes the POSTGRES_* fields explicitly.
# When using a URL, percent-encode reserved characters in credentials.
# DATABASE_URL=postgresql+psycopg://portatlas:encoded-password@db:5432/portatlas
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Only the frontend host port is published by Compose.
WEB_PORT=3000
TZ=UTC
APP_ENV=development
# Server-only Next.js rewrite target, read when next dev starts.
# Never use NEXT_PUBLIC_ for secrets.
BACKEND_ORIGIN=http://backend:8000
